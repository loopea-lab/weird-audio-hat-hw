# KiCad backup folders
*-backups/

# KiCad local preferences
*.kicad_prl

# Board2PDF config
board2pdf.config.ini

# Plot files
*.plt

# Generated outputs
*.pdf
plots/
# Se excluye el CONTENIDO, no la carpeta: git no desciende a un directorio excluido,
# asi que `bom/` haria imposible la excepcion de abajo.
bom/*
# ...menos el BOM interactivo, que es la ayuda de armado y se publica a proposito.
!bom/ibom.html

# But allow everything in releases/ folder
!releases/
!releases/**

# KiCad cache files
fp-info-cache
fp-info-cache*.rpt
*.rpt

# KiCad lock files
~*.lck

# Generated production outputs
production/

# Thumbnails
*_thumbnail.svg

# datasheets ship with the repo
!datasheets/*.pdf
__pycache__/
*.pyc
.pytest_cache/
