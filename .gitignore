# KiCad backup folders
*-backups/

# KiCad local preferences
*.kicad_prl

# Board2PDF config
board2pdf.config.ini

# Plot files
*.plt

# Generated outputs
*.pdf
plots/
# Ignore the folder's contents, not the folder, so the exception below can apply.
bom/*
# ...except the interactive BOM, published as the assembly aid.
!bom/ibom.html

# But allow everything in releases/ folder
!releases/
!releases/**

# KiCad cache files
fp-info-cache
fp-info-cache*.rpt
*.rpt

# KiCad lock files
~*.lck

# Generated production outputs
production/

# Thumbnails
*_thumbnail.svg

# datasheets ship with the repo
!datasheets/*.pdf
__pycache__/
*.pyc
.pytest_cache/
